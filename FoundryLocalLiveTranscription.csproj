<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.18362</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- Needed only for UI Automation, which reads the Live Captions text. -->
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>MeetingAssistant</RootNamespace>
    <AssemblyName>MeetingAssistant</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- Turning on UseWPF drops System.IO from the automatic usings; add it back. -->
    <Using Include="System.IO" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AI.Foundry.Local.WinML" Version="1.2.4" />
  </ItemGroup>

</Project>
